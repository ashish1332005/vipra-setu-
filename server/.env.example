NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/vipra-setu?retryWrites=true&w=majority
# Generate at least 32 random bytes; never reuse this value in another environment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_ISSUER=vipra-sewa-setu-api
JWT_AUDIENCE=vipra-sewa-setu-app
SEED_ADMIN_ON_START=false

ADMIN_NAME=Admin
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password

CLIENT_URL=https://your-client-domain.com
CLIENT_URLS=https://your-client-domain.com
EMAIL_FROM="Vipra Sewa Setu <no-reply@yourdomain.com>"

# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password